{% liquid
  assign is_configurator_page = false
  if request.page_type == 'page' and page.handle == 'contact-us'
    assign is_configurator_page = true
  endif
%}

{% if is_configurator_page %}
  <div class="custom-build-external-app">
    {% comment %}
      SaailMorph configurator (cross-origin iframe).
      Parent Shopify page owns customer auth; iframe cannot read parent JS/cookies
      directly, so we bridge customer identity via postMessage below.
    {% endcomment %}
    <iframe
      id="saailmorph-configurator"
      class="custom-build-external-app-frame"
      src="https://shopify-fe--saailmorphwebsite.netlify.app/"
      title="Custom Build Configurator"
      loading="lazy"
      allow="fullscreen"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
  <script>
    /**
     * Save for Later — parent → iframe customer bridge
     *
     * Why: SaailMorph runs at a different origin, so Shopify `customer` Liquid
     * data is not available inside the iframe. We post the logged-in customer
     * payload so the app can detect auth and later read/write configuration
     * against that customer (e.g. metafield saailmorph.saved_configuration).
     *
     * Message to iframe:
     *   { source: 'shopify-theme', type: 'SHOPIFY_CUSTOMER', customer: {...}|null }
     *
     * Messages from iframe:
     *   { type: 'SAALMORPH_READY' } → parent re-sends customer (covers race
     *   where the app listener was not ready on first postMessage).
     *   { type: 'SAALMORPH_LOGIN_REQUIRED' } → send shopper to account login.
     */
    (function () {
      var IFRAME_ORIGIN = 'https://shopify-fe--saailmorphwebsite.netlify.app';
      var iframe = document.getElementById('saailmorph-configurator');
      if (!iframe) return;

      // Build the same shape we verified in console (id, email, names, orders_count).
      // Prefer window.__CUSTOMER__ if the temp debug helper is re-enabled; otherwise
      // use Liquid `customer` rendered server-side (null when logged out).
      function getCustomerPayload() {
        if (typeof window.__CUSTOMER__ !== 'undefined') {
          return window.__CUSTOMER__;
        }
        return {% if customer %}{
          id: {{ customer.id | json }},
          email: {{ customer.email | json }},
          first_name: {{ customer.first_name | json }},
          last_name: {{ customer.last_name | json }},
          orders_count: {{ customer.orders_count | json }}
        }{% else %}null{% endif %};
      }

      function postCustomerToIframe() {
        if (!iframe.contentWindow) return;
        var customer = getCustomerPayload();
        iframe.contentWindow.postMessage(
          {
            source: 'shopify-theme',
            type: 'SHOPIFY_CUSTOMER',
            customer: customer
          },
          IFRAME_ORIGIN
        );
      }

      // Send once the iframe document has loaded.
      iframe.addEventListener('load', postCustomerToIframe);

      // Re-send when the iframe app asks for customer data.
      window.addEventListener('message', function (event) {
        if (event.origin !== IFRAME_ORIGIN) return;
        if (!event.data || typeof event.data !== 'object') return;

        // App sends SAALMORPH_READY (one A). Older typo SAAILMORPH_READY still accepted.
        if (event.data.type === 'SAALMORPH_READY' || event.data.type === 'SAAILMORPH_READY') {
          postCustomerToIframe();
          return;
        }

        if (event.data.type === 'SAALMORPH_LOGIN_REQUIRED') {
          var accountLink = document.querySelector('a[href*="/account"]');
          var returnPath = window.location.pathname + window.location.search;
          if (accountLink && accountLink.href) {
            window.location.assign(accountLink.href);
            return;
          }
          window.location.assign('/account/login?return_url=' + encodeURIComponent(returnPath));
        }
      });
    })();
  </script>
{% else %}
  <div class="section-gap color-{{ section.settings.color_scheme }}">
    <div class="page-content">
      <div class="page--width text-align-{{ section.settings.content_alignment }}">
        {% if section.settings.show_page_title %}
          <heading-main class="main-heading">
            <{{ section.settings.heading_seo }} class="{{ section.settings.heading_size }}">
              {{ page.title }}
            </{{ section.settings.heading_seo }}>
          </heading-main>
        {% endif %}

        {%- if page.content != blank -%}
          <div class="page-content-text rte">
            {{
              page.content
              | replace: '<table', '<div class="table-content"><table'
              | replace: '</table>', '</table></div>'
            }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{% endif %}

<style>
  .custom-build-external-app {
    width: 100%;
    min-height: 100vh;
  }

  .custom-build-external-app-frame {
    width: 100%;
    min-height: 100vh;
    border: 0;
    display: block;
  }

  #shopify-section-{{ section.id }} {
    --section-gap-top: {{ section.settings.top_space_desktop }}px;
    --section-gap-bottom: {{ section.settings.bottom_space_desktop }}px;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }}.shopify-section {
      --section-gap-top: {{ section.settings.top_space_mobile }}px;
      --section-gap-bottom: {{ section.settings.bottom_space_mobile }}px;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "main-page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "show_page_title",
      "default": false,
      "label": "t:sections.main-page.settings.show_page_title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:sections.main-page.settings.heading_size.label",
      "options": [
        {
          "value": "h1",
          "label": "t:global.heading_size.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_size.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:global.heading_size.options.h3.label"
        },
        {
          "value": "h4",
          "label": "t:global.heading_size.options.h4.label"
        },
        {
          "value": "h5",
          "label": "t:global.heading_size.options.h5.label"
        },
        {
          "value": "h6",
          "label": "t:global.heading_size.options.h6.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_seo",
      "default": "h2",
      "label": "t:global.heading_seo.label",
      "info": "t:global.heading_seo.info",
      "options": [
        {
          "value": "h1",
          "label": "t:global.heading_seo.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.heading_seo.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:global.heading_seo.options.h3.label"
        },
        {
          "value": "h4",
          "label": "t:global.heading_seo.options.h4.label"
        },
        {
          "value": "h5",
          "label": "t:global.heading_seo.options.h5.label"
        },
        {
          "value": "h6",
          "label": "t:global.heading_seo.options.h6.label"
        }
      ]
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "t:global.content_alignment.label",
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:global.section_spacing.content"
    },
    {
      "type": "range",
      "id": "top_space_desktop",
      "label": "t:global.section_spacing.top_space_desktop.label",
      "default": 70,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_desktop",
      "label": "t:global.section_spacing.bottom_space_desktop.label",
      "default": 70,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "top_space_mobile",
      "label": "t:global.section_spacing.top_space_mobile.label",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_mobile",
      "label": "t:global.section_spacing.bottom_space_mobile.label",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 5
    }
  ]
}
{% endschema %}

