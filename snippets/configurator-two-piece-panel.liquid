{% liquid
  assign jacket_menu_items = 'TYPE|FIT|STYLE|SHOULDER PAD|FABRIC|LAPEL STYLE|LAPEL BUTTON HOLE|JACKET BUTTON STYLE / COLOR|SLEEVE BUTTON|JACKET POCKETS|JACKET VENTS|ADD PICKSTITCH|PICKSTITCH COLOR|LINING MATERIAL|MONOGRAM' | split: '|'
%}

<aside class="configurator-side-panel" data-two-piece-panel hidden>
  <div class="configurator-side-panel-left">
    {% render
      'configurator-side-menu',
      title: 'TWO PIECE SUIT- JACKET',
      options: jacket_menu_items,
      aria_label: 'Two piece suit jacket options'
    %}

    <button type="button" class="configurator-side-panel-add" aria-label="Add option">
      +
    </button>

    <div class="configurator-side-panel-icons" aria-hidden="true">
      <span class="configurator-garment-chip">JKT</span>
      <span class="configurator-garment-chip">TRS</span>
      <span class="configurator-garment-chip">VST</span>
      <span class="configurator-garment-chip">ALL</span>
    </div>

    <div class="configurator-side-panel-actions">
      <button type="button" class="configurator-continue-button configurator-side-action-button">NEXT ADD TO CART</button>
      <button type="button" class="configurator-continue-button configurator-side-action-button">SAVE FOR LATER</button>
    </div>
  </div>

  <div class="configurator-side-panel-middle">
    <div class="configurator-submenu" data-configurator-submenu="type" hidden>
      <div class="configurator-submenu-pills" role="group" aria-label="Type">
        {% render 'configurator-pill-button',
          label: 'TWO PIECE SUIT',
          index: 0,
          selected: true,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill'
        %}
        {% render 'configurator-pill-button',
          label: 'THREE PIECE SUIT',
          index: 1,
          selected: false,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill',
          price_note: '+ $288.00'
        %}
      </div>
    </div>

    <div class="configurator-submenu" data-configurator-submenu="fit" hidden>
      <div class="configurator-submenu-pills" role="group" aria-label="Fit">
        {% render 'configurator-pill-button',
          label: 'SLIM FIT',
          index: 0,
          selected: false,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill'
        %}
        {% render 'configurator-pill-button',
          label: 'CLASSIC FIT',
          index: 1,
          selected: false,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill'
        %}
      </div>
    </div>

    <div class="configurator-submenu" data-configurator-submenu="style" hidden>
      <div class="configurator-submenu-pills" role="group" aria-label="Style">
        {% render 'configurator-pill-button',
          label: 'SINGLE BREASTED ONE BUTTON',
          index: 0,
          selected: false,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill'
        %}
        {% render 'configurator-pill-button',
          label: 'SINGLE BREASTED TWO BUTTON',
          index: 1,
          selected: false,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill'
        %}
        {% render 'configurator-pill-button',
          label: 'DOUBLE BREASTED 4X1',
          index: 2,
          selected: false,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill'
        %}
        {% render 'configurator-pill-button',
          label: 'DOUBLE BREASTED 6X2',
          index: 3,
          selected: false,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill'
        %}
      </div>
    </div>

    <div class="configurator-submenu" data-configurator-submenu="fabric" hidden>
      <div class="configurator-submenu-pills" role="group" aria-label="Fabric">
        {% render 'configurator-pill-button',
          label: 'ITALIAN',
          index: 0,
          selected: false,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill'
        %}
        {% render 'configurator-pill-button',
          label: 'AMERICAN',
          index: 1,
          selected: false,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill'
        %}
