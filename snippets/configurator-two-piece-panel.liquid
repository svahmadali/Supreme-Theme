        {% render 'configurator-pill-button',
          label: 'PEAK',
          index: 2,
          selected: false,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill'
        %}
        {% render 'configurator-pill-button',
          label: 'WIDE PEAK',
          index: 3,
          selected: false,
          show_tick_icon: true,
          data_attr: 'data-submenu-pill'
        %}
        {% render 'configurator-pill-button',
          label: 'SHAWL',
