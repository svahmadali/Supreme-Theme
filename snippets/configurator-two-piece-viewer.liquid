<section class="configurator-viewer-stage" data-two-piece-viewer hidden>
  <div class="configurator-viewer-frame">
    <div class="configurator-model-loader" data-configurator-model-loader aria-live="polite" aria-label="Loading 3D model">
      <span class="configurator-model-loader-spinner" aria-hidden="true"></span>
      <span>Loading model...</span>
    </div>
    <model-viewer
      class="configurator-model-viewer"
      src="https://cdn.shopify.com/3d/models/6e1c3c7b8c9ae689/6x2_Buttons_Double_Breasted.glb"
      alt="Two piece suit 3D model"
      camera-controls
      touch-action="pan-y"
      shadow-intensity="1"
      exposure="1"
      auto-rotate
      rotation-per-second="10deg"
      disable-pan
    ></model-viewer>
  </div>
</section>
